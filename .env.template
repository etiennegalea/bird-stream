# -----------------------------------------------------------------------------
# Bird Stream — environment template
#
# Copy to .env and fill in the values:   cp .env.template .env
# .env is gitignored (holds secrets); this template is committed.
# Values marked (build-time) are baked into images — rebuild after changing:
#   docker compose build frontend   (VITE_* flags)
# -----------------------------------------------------------------------------

# -- Frontend (build-time) ----------------------------------------------------

# Leave empty: the frontend calls the API same-origin under /api via traefik.
# Only set for local vite dev against a bare backend (e.g. "localhost:8051").
VITE_NODE_ENV="production"

# "true" = fall back to HLS (~2-6s latency) when WebRTC/WHEP can't connect
# (UDP-blocked networks). "false" = show an error instead (useful when
# debugging WHEP). (build-time)
VITE_API_URL=""
VITE_HLS_FALLBACK="true"

# -- App ----------------------------------------------------------------------

APP_URL="https://stream.lifeofarobin.com"
MAX_VIEWERS="50"

# -- WebRTC / MediaMTX media plane --------------------------------------------

# Comma-separated hosts advertised in ICE candidates:
#   <public IP or grey-cloud DNS name>,<LAN IP>
# Requires 8189/udp forwarded on the router to this machine.
# NEVER use an orange-cloud (Cloudflare-proxied) domain here.
WEBRTC_PUBLIC_HOSTS="203.0.113.1,192.168.1.100"
# SRT publish credentials — must match stream.srt.username/password in the
# Pi's pi-agent/config.yaml.
MEDIAMTX_PUBLISH_USER="picam"
MEDIAMTX_PUBLISH_PASSWORD="change-me"
# "true" = viewers need a valid JWT (?jwt=...) to watch; default public.
# Admin-only mode in the UI enforces authentication regardless of this value.
MEDIAMTX_REQUIRE_READ_AUTH="false"
# Rarely changed: internal MediaMTX control API + stream path name.
MEDIAMTX_API_URL="http://mediamtx:9997"
MEDIAMTX_PATH="birdcam"

# -- Legacy aiortc delivery path (retired; WHEP serves viewers now) -----------
# Only used when AIORTC_ENABLED=true (backend's own capture source):
AIORTC_ENABLED="false"
VIDEO_SOURCE="rtsp://mediamtx:8554/birdcam"
AUDIO_SOURCE="default"

# -- Bird detection (optional; needs image built with INSTALL_DETECTION=true) -
# "true" = install detection dependencies (OpenCV, PyTorch, YOLOv8) in the backend image.
INSTALL_DETECTION="false"
DETECTION_ENABLED="false"

# "auto" follows the first active MediaMTX camera, preferring `birdcam`.
# Set an explicit RTSP URL to pin detection to one camera.
DETECTION_STREAM_URL="auto"
DETECTION_RTSP_BASE_URL="rtsp://mediamtx:8554"
DETECTION_MODEL="yolo11n.pt"
# Bare DETECTION_MODEL names are downloaded into this persistent Docker volume.
DETECTION_MODEL_DIR="/var/lib/birdstream/models"
DETECTION_FPS="2"
DETECTION_CONF="0.4"
DETECTION_CLASSES="bird"
DETECTION_MOTION_GATE="true"
DETECTION_MOTION_MIN_AREA="0.005"

# -- MQTT (backend bridge for Pi transmitter status + start/stop) -------------

# Create the user once: docker exec mosquitto mosquitto_passwd -b \
#   /mosquitto/config/passwd backend <password>
MQTT_HOST="mosquitto"
MQTT_PORT="1883"
MQTT_ENABLED="true"
MQTT_USERNAME="backend"
MQTT_PASSWORD="change-me"
# Blank or invalid values safely fall back to 3 seconds.
PEER_COUNT_POLL_SECONDS="3"

# -- Database -----------------------------------------------------------------

POSTGRES_DB="birb_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
# Must agree with the POSTGRES_* values above (host "db" on the compose network)
DATABASE_URL="postgresql+psycopg2://postgres:change-me@db:5432/birb_db"

# -- Auth ---------------------------------------------------------------------

JWT_SECRET_KEY="generate-a-long-random-string"
JWT_EXPIRY_DAYS="30"
# Short-lived token used only between an admin browser and MediaMTX.
STREAM_ACCESS_TOKEN_MINUTES="10"
# Default admin, seeded on first backend start
ADMIN_EMAIL="admin@birb.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# -- Email --------------------------------------------------------------------

# Brevo transactional; verification + password reset
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="Bird Stream"

# -- Cloudflare tunnel ---------------------------------------------------------

# only if running cloudflared via docker-compose
CLOUDFLARE_TUNNEL_TOKEN=""
