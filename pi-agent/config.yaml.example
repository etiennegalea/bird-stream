# Birdstream Pi agent configuration.
# Copy to config.yaml and edit — config.yaml is gitignored (holds per-device creds).

device:
  id: "pi-01"                 # unique per Pi; topics become camera/<id>/...

mqtt:
  host: "192.168.1.100"       # Proxmox box running mosquitto
  port: 1883                  # 8883 when TLS is enabled
  keepalive: 60
  username: "pi-01"
  password: "change-me"
  tls:
    enabled: false
    ca_cert: null             # e.g. /etc/birdstream/ca.crt

camera:
  auto_detect: true           # true also discovers unlisted capture devices;
                              # false uses only the devices list below
  enabled_by_default: true    # newly attached cameras start automatically
  primary_id: null            # filled automatically; keeps the first camera on
                              # the legacy "birdcam" path even after unplugging
  devices:                    # stable per-camera overrides / allowlist when
                              # auto_detect is false; prefer /dev/v4l/by-id:
    - id: "feeder"
      label: "Feeder camera"
      device: "/dev/v4l/by-id/usb-Example_Camera-video-index0"
      enabled: true
    - id: "nest"
      label: "Nest camera"
      device: "/dev/v4l/by-id/usb-Other_Camera-video-index0"
      enabled: false
      width: 1920            # optional per-camera overrides
      height: 1080
      bitrate: "2500k"
  # Legacy/default settings shared by every detected camera:
  device: "/dev/video0"
  width: 1280
  height: 720
  fps: 30
  bitrate: "1500k"
  use_hw_acceleration: false  # h264_v4l2m2m is flaky / absent on Pi 5; libx264 is reliable

audio:                        # webcam/USB mic -> Opus (required codec for WebRTC)
  enabled: false              # OFF by default (privacy) — set true to capture
                              # the mic; the admin panel must ALSO enable audio
  device: "default"           # ALSA device; find yours with: arecord -l
                              # e.g. "hw:1,0" for card 1, device 0
  bitrate: "64k"
  channels: 1

overlay:                      # timestamp burned in on the Pi (FFmpeg drawtext)
  enabled: true
  time_format: "%Y-%m-%d %H:%M:%S"
  fontfile: "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
  fontsize: 24

stream:
  auto_start: true            # start streaming on boot if srt.host is set
  srt:                        # MediaMTX SRT ingest on the Proxmox box
    host: "192.168.1.100"
    port: 8890
    path: "birdcam"           # first camera path; additional cameras become
                              # birdcam-<pi-id>-<camera-id>
    username: "picam"         # must match MEDIAMTX_PUBLISH_USER on the backend
    password: "change-me"     # must match MEDIAMTX_PUBLISH_PASSWORD

schedule:                     # daily broadcast window — device rests (ffmpeg
                              # stopped, cools down) outside it
  enabled: true               # on by default
  mode: "sun"                 # "sun" = sunrise..sunset; "fixed" = start..end
  start: "06:00"              # fixed-mode window / sun-mode fallback (LOCAL HH:MM;
  end: "20:00"                # start > end wraps past midnight, e.g. 22:00–06:00)
  latitude: null              # sun mode: auto-detected via IP if null,
  longitude: null             # or set explicitly to pin the location
                              # (all settable live from the admin stream panel)
